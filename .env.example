FLASK_APP=app
FLASK_ENV=development

# Once you add your API key below, make sure to not share it with anyone! The API key should remain private.
# Use OPENAI_API_KEY for the standard OpenAI SDK.
OPENAI_API_KEY=

# Or use GITHUB_TOKEN if you are calling GitHub Models through the Azure-compatible endpoint.
GITHUB_TOKEN=
OPENAI_MODEL=gpt-4o
